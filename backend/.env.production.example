# Niveloft backend: a production configuration. Copy into your host's secret store (never commit
# the real values). With APP_ENV=production the server checks these at start-up and lists anything
# unsafe instead of starting.

APP_ENV=production

# Database: a managed MySQL 8.4 with TLS required, and a user with rights on this schema only.
DB_URL=jdbc:mysql://YOUR-DB-HOST:3306/niveloft?sslMode=VERIFY_IDENTITY&serverTimezone=UTC&characterEncoding=utf8
DB_USERNAME=niveloft_app
DB_PASSWORD=change-me
DB_POOL_SIZE=10
# Rate limits are counted in this database, so they hold however many API instances run
# (3 more connections per instance).
RATE_LIMIT_STORE=database
RATE_LIMIT_DB_POOL=3

# openssl rand -base64 48 (keep the old value in JWT_PREVIOUS_SECRET while rotating).
JWT_SECRET=change-me
API_DOCS_ENABLED=false
REQUIRE_HTTPS=true
TRUSTED_PROXIES=1

# The site's real addresses (https, no localhost).
APP_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
SITE_NAME=Niveloft
CONTACT_EMAIL=help@example.com
OPERATOR_EMAILS=you@example.com

# A persistent volume (uploaded evidence must survive deploys).
STORAGE_DIR=/data/uploads
UPLOAD_SCAN=clamav
CLAMAV_HOST=clamav.internal
CLAMAV_PORT=3310

EMAIL_PROVIDER=resend
EMAIL_API_KEY=change-me
EMAIL_FROM=Niveloft <no-reply@example.com>
REQUIRE_EMAIL_VERIFICATION=true
TURNSTILE_SECRET_KEY=change-me
PASSWORD_BREACH_CHECK=hibp

SESSION_IDLE_HOURS=12
SESSION_MAX_HOURS=24
SESSION_REMEMBER_DAYS=14           # "keep me signed in": an HttpOnly cookie from this API (docs/launch/README.md); 0 turns it off
SESSION_COOKIE_SAMESITE=auto       # lax if the API is on the app's own site (api.example.com beside app.example.com)

# AI: caps above 0 are required while AI is on.
AI_PROVIDER=openai
AI_API_KEY=change-me
AI_MODEL=change-me
AI_BASE_URL=https://api.openai.com/v1
AI_MAX_REQUESTS_PER_HOUR=30
AI_MAX_REQUESTS_PER_DAY=1000
AI_MAX_REQUESTS_PER_PROJECT_PER_DAY=300
AI_MAX_TOKENS_PER_MONTH=5000000
AI_MAX_CONCURRENT=8
VOICE_PROVIDER=none
# FORECAST_MODEL_FILE=/app/models/model.json   # optional: a trained model on trial beside Niveloft's forecast
FORECAST_MODEL_ALLOW_SYNTHETIC=false

AUDIT_RETENTION_DAYS=365
